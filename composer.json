{
    "name": "hoceineel/filament-usage-billing",
    "description": "Metered, modular subscription billing for multi-tenant Filament applications.",
    "keywords": [
        "hoceineel",
        "laravel",
        "filament",
        "billing",
        "subscriptions",
        "metering",
        "usage-based-billing"
    ],
    "homepage": "https://github.com/HoceineEL/filament-usage-billing",
    "license": "MIT",
    "authors": [
        {
            "name": "Hoceine El Idrissi",
            "email": "contact@hoceine.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HoceineEl\\UsageBilling\\": "src/",
            "HoceineEl\\UsageBilling\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HoceineEl\\UsageBilling\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HoceineEl\\UsageBilling\\UsageBillingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
